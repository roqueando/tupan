/* Minimal color palette — black and #f1efe7 only.
   0 = black, 1000 = #f1efe7 (the light color) */
{
  "Global": {
    "Color": {
      "Gray": {
        "0":    "#000000",
        "100":  "#0a0a0a",
        "150":  "#0f0f0f",
        "200":  "#141414",
        "300":  "#1e1e1e",
        "400":  "#282828",
        "500":  "#323232",
        "600":  "#505050",
        "700":  "#707070",
        "800":  "#a0a0a0",
        "900":  "#d0d0d0",
        "950":  "#e8e5dc",
        "975":  "#f0ede5",
        "1000": "#f1efe7"
      },
      "Blue": {
        "0":    "#000000",
        "500":  "#000000",
        "1000": "#f1efe7"
      }
    }
  }
}
